<UserControl x:Class="Danawa.Client.Views.CarDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SpecLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,9"/>
        </Style>
        <Style x:Key="SpecValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 차량이 없거나 비활성화됨 (NOT_FOUND) -->
        <ContentControl Style="{StaticResource EmptyStateBox}" Content="차량을 찾을 수 없습니다"
                        Tag="판매가 중단되었거나 존재하지 않는 차량입니다" Margin="48,24" VerticalAlignment="Top"
                        Visibility="{Binding NotFound, Converter={StaticResource BoolToVisible}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding NotFound, Converter={StaticResource BoolToCollapsed}}">
            <StackPanel Margin="48,20,48,24" MaxWidth="1180">
                <TextBlock Text="{Binding Breadcrumb}" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                <TextBlock Style="{StaticResource LoadingText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

                <!-- ① 차량 정보 + 관심 하트 -->
                <Border Style="{StaticResource Card}" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="480"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ImagePlaceholder}" Height="290">
                            <Image Source="{Binding Car.Image}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="28,12,0,0">
                            <TextBlock Text="{Binding Car.Car.BrandName}" Style="{StaticResource MutedText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding Car.Car.CarName}" FontSize="30" FontWeight="Bold"/>
                                <Button Style="{StaticResource PlainButton}" Margin="40,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="관심 하트"
                                        ToolTip="관심 등록/해제">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteHeartConverter}}"
                                                   Foreground="{StaticResource HeartBrush}" FontSize="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="관심" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,14,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="기본 가격" Style="{StaticResource SpecLabel}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BasePriceText}" Style="{StaticResource SpecValue}" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Text="복합연비" Style="{StaticResource SpecLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Car.FuelText}" Style="{StaticResource SpecValue}"/>
                                <TextBlock Grid.Row="2" Text="출시일" Style="{StaticResource SpecLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReleaseDateText}" Style="{StaticResource SpecValue}"/>
                                <TextBlock Grid.Row="3" Text="옵션" Style="{StaticResource SpecLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OptionCountText}" Style="{StaticResource SpecValue}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ② 옵션 선택 + ③ 예상 견적 패널 -->
                <TextBlock Text="옵션 선택" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="390"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,6" VerticalAlignment="Top">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Options}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalContentAlignment="Center"
                                                          AutomationProperties.Name="{Binding Option.OptionName}">
                                                    <TextBlock Text="{Binding Option.OptionName}" FontSize="14" Margin="10,0,0,0"/>
                                                </CheckBox>
                                                <TextBlock HorizontalAlignment="Right" FontWeight="Bold"
                                                           Text="{Binding PriceText}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="선택 가능한 옵션이 없습니다." Margin="0,14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Options.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 화면에 보이는 계산 결과일 뿐 — 저장 금액은 서버가 DB 가격으로 다시 계산한다 (R4) -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="예상 견적" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="차량 기본가" Style="{StaticResource MutedText}" FontSize="13"/>
                                    <TextBlock Text="{Binding BasePriceText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedOptionCount, StringFormat='선택 옵션 {0}개'}" Style="{StaticResource MutedText}" FontSize="13"/>
                                    <TextBlock Text="{Binding SelectedOptionTotalText}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <Grid>
                                        <TextBlock Text="합계" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EstimatedTotalText}" HorizontalAlignment="Right"
                                                   Style="{StaticResource PriceText}" FontSize="22"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ④ 관심 등록 / 견적함에 담기: 요청에는 car_id와 option_ids만 (QUO-02) -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" MinHeight="46"
                                    Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="관심 등록 버튼">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteHeartConverter}}"
                                               Foreground="{StaticResource HeartBrush}" Margin="0,0,6,0"/>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="관심 등록"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Text" Value="관심 해제"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Content="견적함에 담기" Style="{StaticResource PrimaryButton}" MinHeight="46"
                                    FontSize="15" Command="{Binding AddToQuoteCommand}"/>
                        </Grid>
                        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" HorizontalAlignment="Right"
                                   Visibility="{Binding Notice, Converter={StaticResource StringToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
