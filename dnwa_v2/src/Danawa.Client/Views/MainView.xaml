<UserControl x:Class="Danawa.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 인기모델 TOP5 한 줄: 순위 / 썸네일 / 브랜드·차량명·가격 / 관심 수·하트 -->
        <DataTemplate x:Key="Top5RowTemplate">
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PlainButton}"
                            Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Car.CarName}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" BorderBrush="#C9CFD6" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Rank}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </Border>
                            <Border Style="{StaticResource ImagePlaceholder}" Width="110" Height="62" Margin="12,0,14,0">
                                <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Car.BrandName}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding Car.CarName}" FontSize="15" FontWeight="Bold" Margin="0,2"/>
                                <TextBlock Text="{Binding PriceRangeText}" Style="{StaticResource PriceText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding FavoriteCount, StringFormat='관심 {0}'}" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"/>
                        <Button Style="{StaticResource HeartButton}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                Content="{Binding IsFavorite, Converter={StaticResource FavoriteHeartConverter}}"
                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="관심 등록/해제"
                                AutomationProperties.Name="{Binding Car.CarName, StringFormat='TOP5 {0} 관심'}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="EmptyTop5Text" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Text" Value="최근 7일 관심 등록이 없습니다."/>
            <Setter Property="Margin" Value="0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,24,48,16" MaxWidth="1180">
            <TextBlock Style="{StaticResource LoadingText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <!-- ⑤ 브랜드 그리드: 클릭 → 브랜드별 목록 -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Brands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PlainButton}" Padding="0,6" HorizontalContentAlignment="Center"
                                    Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Brand.BrandName}">
                                <StackPanel>
                                    <Grid Width="48" Height="48">
                                        <Ellipse Fill="{StaticResource PlaceholderBrush}" Stroke="{StaticResource BorderBrush}"/>
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Text="{Binding Brand.BrandName}" FontSize="12" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ⑥ 오늘의 견적 요청 현황 -->
            <TextBlock Text="오늘의 견적 요청 현황" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="28,20">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="오늘 견적 요청" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TodayQuotes, StringFormat='{}{0:N0}건'}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="36,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalQuotes, StringFormat='누적 견적 {0:N0}건'}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="차량 둘러보기" Style="{StaticResource PrimaryButton}" Width="160"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding DataContext.ShowAllCarsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28,20">
                    <Grid>
                        <!-- 로그인 시: 내 견적함·관심 건수 -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowMyStats, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="내 견적함" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MyQuotes, StringFormat='{}{0:N0}건'}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="36,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MyFavorites, StringFormat='관심 모델 {0:N0}건'}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Content="견적함 열기" Style="{StaticResource SecondaryButton}" Width="160"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding ShowMyStats, Converter={StaticResource BoolToVisible}}"
                                Command="{Binding DataContext.NavigateToQuotesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <!-- 비로그인 시 -->
                        <TextBlock Text="로그인하면 내 견적함과 관심 모델 건수를 볼 수 있습니다." VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,180,0"
                                   Visibility="{Binding ShowMyStats, Converter={StaticResource BoolToCollapsed}}"/>
                        <Button Content="로그인" Style="{StaticResource SecondaryButton}" Width="160"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Visibility="{Binding ShowMyStats, Converter={StaticResource BoolToCollapsed}}"
                                Command="{Binding DataContext.NavigateToLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ⑦ 오늘의 인기 차량 (없으면 섹션 자체를 숨긴다) -->
            <StackPanel Visibility="{Binding HasDailyTop, Converter={StaticResource BoolToVisible}}">
                <TextBlock Text="오늘의 인기 차량" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Padding="20" DataContext="{Binding DailyTop}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ImagePlaceholder}" Height="180">
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="32,8,0,0">
                            <TextBlock Text="{Binding Car.BrandName}" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Car.CarName}" FontSize="28" FontWeight="Bold" Margin="0,4,0,8"/>
                            <TextBlock Text="{Binding PriceRangeText}" Style="{StaticResource PriceText}" FontSize="19"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0">
                                <Run Text="{Binding ReleaseText, Mode=OneWay}"/>
                                <Run Text=" ·  복합연비 "/>
                                <Run Text="{Binding FuelText, Mode=OneWay}"/>
                            </TextBlock>
                            <Border HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,4" CornerRadius="12"
                                    Background="#FDECEA" BorderBrush="#F3B7AE" BorderThickness="1">
                                <TextBlock Text="{Binding QuoteCount, StringFormat='오늘 견적 {0}건'}" FontSize="12"
                                           Foreground="{StaticResource HeartBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}" Width="150" Margin="0,0,12,0"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="오늘의 인기 차량 관심">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IsFavorite, Converter={StaticResource FavoriteHeartConverter}}"
                                               Foreground="{StaticResource HeartBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="관심"/>
                                </StackPanel>
                            </Button>
                            <Button Content="상세보기" Style="{StaticResource PrimaryButton}" Width="150"
                                    Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ⑧ 인기모델 TOP5: 최근 7일 관심 등록 수 기준 (관리자 통계 TOP5는 견적 기준 — 혼동 금지) -->
            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="국산차 인기모델 TOP5" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12">
                            <Hyperlink Foreground="{StaticResource MutedBrush}" TextDecorations="{x:Null}"
                                       Command="{Binding DataContext.ShowDomesticCarsCommand, RelativeSource={RelativeSource AncestorType=Window}}">더보기 ›</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FavoriteDomestic}" ItemTemplate="{StaticResource Top5RowTemplate}"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyTop5Text}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FavoriteDomestic.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="수입차 인기모델 TOP5" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12">
                            <Hyperlink Foreground="{StaticResource MutedBrush}" TextDecorations="{x:Null}"
                                       Command="{Binding DataContext.ShowImportedCarsCommand, RelativeSource={RelativeSource AncestorType=Window}}">더보기 ›</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding FavoriteImported}" ItemTemplate="{StaticResource Top5RowTemplate}"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyTop5Text}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FavoriteImported.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ⑨ 푸터: 프로젝트 정보 + 서버 연결 상태 -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,32,0,0" Padding="0,14,0,0">
                <Grid>
                    <TextBlock Text="다나와 자동차 v2  ·  광주인력개발원 프로젝트  ·  2026" Style="{StaticResource MutedText}"/>
                    <TextBlock HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Text" Value="서버 연결 끊김  ·  v2.0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsConnected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Text" Value="서버 연결됨  ·  v2.0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
