<UserControl x:Class="Danawa.Client.Views.AdminStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="840">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <TextBlock Text="통계" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

            <!-- ① 기간 지정: 서버는 created_at >= from AND < to+1일 범위식으로 조회 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="기간" Style="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBox Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="시작일"/>
                <TextBlock Text="~" VerticalAlignment="Center" Margin="10,0"/>
                <TextBox Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" Width="160" AutomationProperties.Name="종료일"/>
                <Button Content="조회" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"
                        Width="110" Margin="16,0,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}"/>

            <!-- ② 일자별 견적 건수 (세로 막대). 0건인 날은 응답에 없어 화면에서 0으로 채운다. 재조회 시 먼저 비운다 (ADM-09) -->
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="일자별 견적 건수" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource LoadingText}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                    <Border BorderBrush="#C9CFD6" BorderThickness="0,0,0,1" Margin="20,0">
                        <ItemsControl ItemsSource="{Binding DailyPoints}" Height="190">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                        <Rectangle Width="44" Height="{Binding BarHeight}" Fill="#8FB4DD"
                                                   Stroke="#6F9CCF" StrokeThickness="1" ToolTip="{Binding Day}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding DailyPoints}" Margin="20,6,20,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DayLabel}" Style="{StaticResource MutedText}" FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ③ 주간 견적 TOP5 (최근 7일, 견적 기준) -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="주간 견적 TOP5 (국산)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding WeeklyDomestic}" Style="{StaticResource RankTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="70"/>
                            <DataGridTextColumn Header="차량명" Binding="{Binding CarName}" Width="*"/>
                            <DataGridTextColumn Header="견적" Binding="{Binding CountText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="주간 견적 TOP5 (수입)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding WeeklyImported}" Style="{StaticResource RankTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="70"/>
                            <DataGridTextColumn Header="차량명" Binding="{Binding CarName}" Width="*"/>
                            <DataGridTextColumn Header="견적" Binding="{Binding CountText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
