<UserControl x:Class="Danawa.Client.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="840">
    <UserControl.Resources>
        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24">
            <Grid Margin="0,0,0,18">
                <TextBlock Text="대시보드" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding AsOfText}" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Style="{StaticResource LoadingText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <!-- ① 요약 카드: 총 견적 · 오늘 견적 · 오늘의 인기 차량 (IF-ADM-009 + IF-CAR-008) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="총 견적" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock Text="{Binding TotalQuotes, StringFormat='{}{0:N0}건'}" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="is_deleted=0 기준" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="오늘 견적" Style="{StaticResource SummaryLabel}"/>
                        <TextBlock Text="{Binding TodayQuotes, StringFormat='{}{0:N0}건'}" Style="{StaticResource SummaryValue}"/>
                        <TextBlock Text="00:00 ~ 현재" Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="오늘의 인기 차량" Style="{StaticResource SummaryLabel}"/>
                        <StackPanel Visibility="{Binding HasDailyTop, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{Binding DailyTop.CarName}" Style="{StaticResource SummaryValue}"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11">
                                <Run Text="{Binding DailyTop.QuoteCount, Mode=OneWay, StringFormat='오늘 {0}건'}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding DailyTop.BrandName, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="오늘 견적 없음" Style="{StaticResource SummaryValue}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="20" Visibility="{Binding HasDailyTop, Converter={StaticResource BoolToCollapsed}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ② 주간 견적 TOP5: 최근 7일 = INTERVAL 6 DAY. 이 화면은 견적 기준 (메인은 관심 기준) -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="주간 견적 TOP5 (국산)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding WeeklyDomestic}" Style="{StaticResource RankTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="70"/>
                            <DataGridTextColumn Header="차량명" Binding="{Binding CarName}" Width="*"/>
                            <DataGridTextColumn Header="브랜드" Binding="{Binding BrandName}" Width="110"/>
                            <DataGridTextColumn Header="견적" Binding="{Binding CountText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="주간 견적 TOP5 (수입)" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding WeeklyImported}" Style="{StaticResource RankTable}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="순위" Binding="{Binding Rank}" Width="70"/>
                            <DataGridTextColumn Header="차량명" Binding="{Binding CarName}" Width="*"/>
                            <DataGridTextColumn Header="브랜드" Binding="{Binding BrandName}" Width="110"/>
                            <DataGridTextColumn Header="견적" Binding="{Binding CountText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
