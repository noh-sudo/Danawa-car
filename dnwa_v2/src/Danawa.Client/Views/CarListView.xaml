<UserControl x:Class="Danawa.Client.Views.CarListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- 정렬 버튼: 선택된 쪽은 파란 테두리 -->
        <Style x:Key="SortButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,24,48,24" MaxWidth="1180">
            <!-- ① 검색어·건수·정렬 -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Cars.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="정렬: 인기순" Style="{StaticResource SortButton}" Tag="{Binding IsPopularSort}"
                            Command="{Binding SortPopularCommand}"/>
                    <Button Content="가격 낮은순" Style="{StaticResource SortButton}" Tag="{Binding IsPriceSort}"
                            Command="{Binding SortPriceCommand}"/>
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource LoadingText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <!-- ③ 결과 0건: ERROR가 아니라 OK + 빈 배열이므로 안내 박스로 표시한다 (CAR-04) -->
            <ContentControl Style="{StaticResource EmptyStateBox}" Content="검색 결과가 없습니다"
                            Tag="다른 검색어를 입력하거나 브랜드를 선택해 보세요"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}"/>

            <!-- ② 차량 카드 3열 -->
            <ItemsControl ItemsSource="{Binding Cars}" Margin="-10,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="10" Padding="14">
                            <StackPanel>
                                <Button Style="{StaticResource PlainButton}"
                                        Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Car.CarName}">
                                    <Border Style="{StaticResource ImagePlaceholder}" Height="140">
                                        <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                    </Border>
                                </Button>
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Car.BrandName}" Style="{StaticResource MutedText}"/>
                                        <TextBlock Text="{Binding Car.CarName}" FontSize="17" FontWeight="Bold" Margin="0,2,0,6"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource HeartButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Content="{Binding IsFavorite, Converter={StaticResource FavoriteHeartConverter}}"
                                            Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="관심 등록/해제"
                                            AutomationProperties.Name="{Binding Car.CarName, StringFormat='{}{0} 관심'}"/>
                                </Grid>
                                <TextBlock Text="{Binding PriceRangeText}" Style="{StaticResource PriceText}" FontSize="15"/>
                                <TextBlock Text="{Binding FuelText, StringFormat='복합연비 {0}'}" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
