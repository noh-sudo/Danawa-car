<UserControl x:Class="Danawa.Client.Views.QuoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,24,48,24" MaxWidth="1180">
            <!-- ① 견적 목록: is_deleted=0인 내 견적만 최신순 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="내 견적함" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Quotes.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource LoadingText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <!-- 견적 1건 = 카드 1개. 옵션은 카드 안에 나열한다 (QUO-06) -->
            <ItemsControl ItemsSource="{Binding Quotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ImagePlaceholder}" Width="120" Height="72"
                                        VerticalAlignment="Top">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Quote.BrandName}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Quote.CarName}" FontSize="19" FontWeight="Bold" Margin="0,2,0,4"/>
                                            <TextBlock Text="{Binding CarPriceText, StringFormat='기본가 {0}'}" Style="{StaticResource MutedText}" FontSize="13"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource MutedText}" Margin="320,0,0,0"/>
                                    </Grid>
                                    <!-- ② 선택 옵션 (스냅샷) -->
                                    <ItemsControl ItemsSource="{Binding OptionLines}" Margin="0,10,0,0">
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OptionLines.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                        <ItemsControl.Template>
                                            <ControlTemplate TargetType="ItemsControl">
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                                    <ItemsPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </ItemsControl.Template>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="16,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="304"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat='·  {0}'}" FontSize="13"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding PriceText}" Style="{StaticResource MutedText}" FontSize="13"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <!-- ③ 표시 금액 = 저장 시점 스냅샷 (QUO-05) / ④ 소프트 삭제 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding TotalPriceText}" Style="{StaticResource PriceText}" FontSize="20"
                                               VerticalAlignment="Center" Margin="0,0,18,0"/>
                                    <Button Content="삭제" Style="{StaticResource SecondaryButton}" Width="110"
                                            Command="{Binding DeleteCommand}"
                                            AutomationProperties.Name="{Binding Quote.QuoteId, StringFormat='견적 {0} 삭제'}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ContentControl Style="{StaticResource EmptyStateBox}" Content="저장된 견적이 없습니다"
                            Tag="차량 상세 화면에서 옵션을 골라 견적함에 담아보세요"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
