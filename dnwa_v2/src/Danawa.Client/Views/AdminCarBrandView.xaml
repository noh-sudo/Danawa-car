<UserControl x:Class="Danawa.Client.Views.AdminCarBrandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="840">
    <UserControl.Resources>
        <!-- is_active → "판매중"/"삭제됨" (차량), "노출"/"숨김" (브랜드) -->
        <Style x:Key="CarStatusText" TargetType="TextBlock">
            <Setter Property="Text" Value="삭제됨"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Text" Value="판매중"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrandStatusText" TargetType="TextBlock">
            <Setter Property="Text" Value="숨김"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Text" Value="노출"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OriginText" TargetType="TextBlock">
            <Setter Property="Text" Value="수입"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OriginType}" Value="DOMESTIC">
                    <Setter Property="Text" Value="국산"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FormTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ① 차량 / 브랜드 탭 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <Button Content="차량" Style="{StaticResource TabButton}" Tag="{Binding IsCarTab}"
                        Command="{Binding SwitchToCarTabCommand}"/>
                <Button Content="브랜드" Style="{StaticResource TabButton}" Tag="{Binding IsBrandTab}"
                        Command="{Binding SwitchToBrandTabCommand}"/>
            </StackPanel>
        </Border>

        <!-- ===== 차량 탭 ===== -->
        <Grid Grid.Row="1" Visibility="{Binding IsCarTab, Converter={StaticResource BoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ② 목록: is_active=0인 차량도 "삭제됨"으로 함께 보여준다 -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="차량 목록" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{Binding Cars.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
                    </StackPanel>
                    <Button Content="+ 신규" Style="{StaticResource SecondaryButton}" Width="110" HorizontalAlignment="Right"
                            Command="{Binding NewCarCommand}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource LoadingText}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                <DataGrid ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCarForList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding CarId}" Width="60"/>
                        <DataGridTextColumn Header="차량명" Binding="{Binding CarName}" Width="*"/>
                        <DataGridTextColumn Header="브랜드" Binding="{Binding BrandName}" Width="120"/>
                        <DataGridTextColumn Header="기본가(만원)" Binding="{Binding CarPrice, Converter={StaticResource WonToManwon}}" Width="110"/>
                        <DataGridTemplateColumn Header="상태" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource CarStatusText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <!-- ③ 등록 / 수정 폼: car_id가 있으면 수정, 없으면 등록 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding CarFormTitle}" Style="{StaticResource FormTitle}"/>

                    <TextBlock Text="브랜드" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Brands}" SelectedItem="{Binding CarFormBrand}"
                              DisplayMemberPath="BrandName" Margin="0,0,0,14"/>

                    <TextBlock Text="차량명" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CarFormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="기본 가격 (원)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CarFormPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="연비 (최소 / 최대)" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CarFormFuelMin, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBox Grid.Column="2" Text="{Binding CarFormFuelMax, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <TextBlock Text="출시일 (YYYY-MM-DD)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CarFormReleaseDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="이미지 경로" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CarFormImageUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <!-- 음수 가격·연비 역전은 서버가 VALIDATION, 뚫려도 DB CHECK가 막는다 -->
                    <TextBlock Text="{Binding CarFormError}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                               Visibility="{Binding CarFormError, Converter={StaticResource StringToVisibility}}"/>

                    <!-- ④ 저장 / 삭제(is_active=0 소프트 삭제) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="저장" Style="{StaticResource PrimaryButton}" MinHeight="44"
                                Command="{Binding SaveCarCommand}" AutomationProperties.Name="차량 저장"/>
                        <Button Grid.Column="2" Content="삭제" Style="{StaticResource SecondaryButton}" MinHeight="44"
                                Command="{Binding DeleteCarCommand}" AutomationProperties.Name="차량 삭제"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 브랜드 탭 ===== -->
        <Grid Grid.Row="1" Visibility="{Binding IsBrandTab, Converter={StaticResource BoolToVisible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="브랜드 목록" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{Binding Brands.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
                    </StackPanel>
                    <Button Content="+ 신규" Style="{StaticResource SecondaryButton}" Width="110" HorizontalAlignment="Right"
                            Command="{Binding NewBrandCommand}"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Brands}" SelectedItem="{Binding SelectedBrandForList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding BrandId}" Width="60"/>
                        <DataGridTextColumn Header="브랜드명" Binding="{Binding BrandName}" Width="*"/>
                        <DataGridTemplateColumn Header="구분" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource OriginText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="상태" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BrandStatusText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding BrandFormTitle}" Style="{StaticResource FormTitle}"/>

                    <TextBlock Text="브랜드명" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BrandFormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="로고 이미지 경로" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BrandFormIcon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="국산 / 수입" Style="{StaticResource FieldLabel}"/>
                    <ComboBox SelectedValue="{Binding BrandFormOriginType}" SelectedValuePath="Tag" Margin="0,0,0,14">
                        <ComboBoxItem Content="국산 (DOMESTIC)" Tag="DOMESTIC"/>
                        <ComboBoxItem Content="수입 (IMPORT)" Tag="IMPORT"/>
                    </ComboBox>

                    <CheckBox Content="노출 (is__active)" IsChecked="{Binding BrandFormIsActive}" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding BrandFormError}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                               Visibility="{Binding BrandFormError, Converter={StaticResource StringToVisibility}}"/>

                    <Button Content="저장" Style="{StaticResource PrimaryButton}" MinHeight="44"
                            Command="{Binding SaveBrandCommand}" AutomationProperties.Name="브랜드 저장"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
