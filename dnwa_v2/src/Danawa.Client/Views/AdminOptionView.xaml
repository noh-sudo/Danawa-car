<UserControl x:Class="Danawa.Client.Views.AdminOptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="840">
    <UserControl.Resources>
        <Style x:Key="OptionStatusText" TargetType="TextBlock">
            <Setter Property="Text" Value="중단"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Text" Value="사용"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="옵션 관리" Style="{StaticResource PageTitle}" Margin="0,0,0,18"/>

        <!-- ① 차량 선택: 옵션은 차량에 속한다. 고른 차량의 옵션만 조회 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,18">
            <TextBlock Text="차량 선택" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" Width="360" HorizontalAlignment="Left"
                      AutomationProperties.Name="차량 선택">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding BrandName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding CarName, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ② 옵션 목록: 같은 차량에 같은 옵션명은 UNIQUE (중복 시 CONFLICT) -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="옵션 목록" Style="{StaticResource SectionTitle}" Margin="0"/>
                        <TextBlock Text="{Binding Options.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
                    </StackPanel>
                    <Button Content="+ 신규" Style="{StaticResource SecondaryButton}" Width="110" HorizontalAlignment="Right"
                            Command="{Binding NewOptionCommand}"/>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="위에서 차량을 먼저 선택하세요." Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedCar}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOptionForList}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding OptionId}" Width="60"/>
                        <DataGridTextColumn Header="옵션명" Binding="{Binding OptionName}" Width="*"/>
                        <DataGridTextColumn Header="가격(원)" Binding="{Binding Price, StringFormat='{}{0:N0}'}" Width="130"/>
                        <DataGridTemplateColumn Header="상태" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource OptionStatusText}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding OptionFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="옵션명" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding OptionFormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="가격 (원)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding OptionFormPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <CheckBox Content="선택 가능 (is__active)" IsChecked="{Binding OptionFormIsActive}" Margin="0,0,0,14"/>

                    <TextBlock Text="{Binding OptionFormError}" Style="{StaticResource ErrorText}" Margin="0,0,0,10"
                               Visibility="{Binding OptionFormError, Converter={StaticResource StringToVisibility}}"/>

                    <!-- ③ 삭제는 is_active=0. 저장된 견적은 옵션명·가격 스냅샷이라 영향 없음 (QUO-05) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="저장" Style="{StaticResource PrimaryButton}" MinHeight="44"
                                Command="{Binding SaveOptionCommand}" AutomationProperties.Name="옵션 저장"/>
                        <Button Grid.Column="2" Content="삭제" Style="{StaticResource SecondaryButton}" MinHeight="44"
                                Command="{Binding DeleteOptionCommand}" AutomationProperties.Name="옵션 삭제"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
