<Window x:Class="Danawa.Client.Views.AdminShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Danawa.Client.ViewModels"
        xmlns:views="clr-namespace:Danawa.Client.Views"
        mc:Ignorable="d"
        Title="다나와 자동차 관리자" Height="800" Width="1280"
        FontFamily="Malgun Gothic" Background="{StaticResource PageBackground}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminCarBrandViewModel}">
            <views:AdminCarBrandView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminOptionViewModel}">
            <views:AdminOptionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminStatsViewModel}">
            <views:AdminStatsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminLogViewModel}">
            <views:AdminLogView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 상단 다크바 -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource AdminBarBrush}" Height="60">
            <TextBlock Text="다나와 자동차  관리자" Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="28,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
                <TextBlock Foreground="#D5D9DE" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Run Text="{Binding LoginId, Mode=OneWay}"/>
                    <Run Text="(ADMIN)"/>
                </TextBlock>
                <Button Content="로그아웃" Command="{Binding LogoutCommand}" Style="{StaticResource ButtonBase}"
                        Background="#4A515A" BorderBrush="#6A727C" BorderThickness="1" Foreground="White"
                        Padding="14,4" MinHeight="30"/>
            </StackPanel>
        </Grid>

        <!-- 좌측 사이드바: 현재 메뉴 강조 -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,12,0,0">
                <Button Style="{StaticResource SideMenuButton}" Content="대시보드"
                        Tag="{Binding IsDashboardActive}" Command="{Binding ShowDashboardCommand}"/>
                <Button Style="{StaticResource SideMenuButton}" Content="차량 · 브랜드 관리"
                        Tag="{Binding IsCarBrandActive}" Command="{Binding ShowCarBrandCommand}"/>
                <Button Style="{StaticResource SideMenuButton}" Content="옵션 관리"
                        Tag="{Binding IsOptionActive}" Command="{Binding ShowOptionCommand}"/>
                <Button Style="{StaticResource SideMenuButton}" Content="통계"
                        Tag="{Binding IsStatsActive}" Command="{Binding ShowStatsCommand}"/>
                <Button Style="{StaticResource SideMenuButton}" Content="로그 조회"
                        Tag="{Binding IsLogActive}" Command="{Binding ShowLogCommand}"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentViewModel}" Focusable="False"/>
    </Grid>
</Window>
