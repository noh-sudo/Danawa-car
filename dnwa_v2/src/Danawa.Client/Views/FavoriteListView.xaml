<UserControl x:Class="Danawa.Client.Views.FavoriteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,24,48,24" MaxWidth="1180">
            <!-- ① 목록 조회: 사용자는 세션에서 꺼낸다 (R2) -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="관심 모델" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding Favorites.Count, StringFormat='{}{0}건'}" Style="{StaticResource CountText}"/>
            </StackPanel>

            <TextBlock Style="{StaticResource LoadingText}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

            <ItemsControl ItemsSource="{Binding Favorites}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource ImagePlaceholder}" Width="126" Height="74">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Favorite.BrandName}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Favorite.CarName}" FontSize="19" FontWeight="Bold" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding PriceText}" Style="{StaticResource PriceText}"/>
                                </StackPanel>
                                <!-- ② 상세보기 / 관심 해제: 해제 즉시 목록에서 사라진다 (FAV-04) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="상세보기" Style="{StaticResource SecondaryButton}" Width="150" Margin="0,0,12,0"
                                                Command="{Binding DataContext.SelectCarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource SecondaryButton}" Width="150"
                                                Command="{Binding UnfavoriteCommand}"
                                                AutomationProperties.Name="{Binding Favorite.CarName, StringFormat='{}{0} 관심 해제'}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="♥" Foreground="{StaticResource HeartBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="관심 해제"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ③ 빈 상태 -->
            <ContentControl Style="{StaticResource EmptyStateBox}" Content="관심 등록한 차량이 없습니다"
                            Tag="차량 상세 화면에서 하트를 눌러 담아보세요"
                            Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisible}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
